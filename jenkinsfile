stage('Terraform Apply') {
  steps {
    withCredentials([
      [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
      string(credentialsId: 'db-pass', variable: 'DB_PASS')
    ]) {
      dir('terraform') {
        sh '''
          terraform apply -auto-approve \
          -var="db_password=$DB_PASS"
        '''
      }
    }
  }
}